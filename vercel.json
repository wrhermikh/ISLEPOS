{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "maldives-shop-manager": {
      "root": "artifacts/maldives-shop-manager",
      "framework": "vite",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "maldives-shop-manager"
      }
    }
  ]
}
