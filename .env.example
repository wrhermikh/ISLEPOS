# Server-only. Use the Supabase PostgreSQL pooler with SSL enabled.
DATABASE_URL=
PG_POOL_MAX=2

# Supabase project URL and public anon key.
# The VITE_ values are safe for the browser; never use a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Verified owner email receives the first Owner role.
SHOP_OWNER_EMAIL=
